{
  "name": "vietnam-living-summit",
  "main": "scripts/site-worker.mjs",
  "compatibility_date": "2026-08-13",
  "routes": [
    {
      "pattern": "vietnam-living-summit.com",
      "custom_domain": true
    },
    {
      "pattern": "www.vietnam-living-summit.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "REGISTRATION_URL": "https://vietnam-living-summit.com/#event-signup",
    "REGISTRATION_NOTIFY_TO": "marketing@tubudd.com",
    "EMAIL_FROM": "hello@vietnam-living-summit.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@vietnam-living-summit.com"]
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
