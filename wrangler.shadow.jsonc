{
  "name": "vietnam-living-summit-shadow",
  "main": "scripts/shadow-worker.mjs",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "REGISTRATION_URL": "https://vietnam-living-summit-shadow.jhelyar04.workers.dev/#event-signup",
    "REGISTRATION_NOTIFY_TO": "marketing@tubudd.com",
    "PARTNER_FOLLOW_UP_DAYS": "3",
    "PARTNER_CONTACT_EMAIL": "marketing@tubudd.com",
    "EMAIL_FROM": "hello@vietnam-living-summit.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@vietnam-living-summit.com"]
    }
  ],
  "d1_databases": [
    {
      "binding": "REGISTRATIONS",
      "database_name": "vls2026-attendees-shadow",
      "database_id": "3563efff-8952-402f-b727-309f96c22949"
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
