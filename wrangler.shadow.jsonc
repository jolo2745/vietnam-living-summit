{
  "name": "vietnam-living-summit-shadow",
  "main": "scripts/shadow-worker.mjs",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "REGISTRATION_URL": "https://docs.google.com/forms/d/e/1FAIpQLSfb38vO1XAUqsfDnkSAEq80xFJu-Pva3_LScdxCtn5EaRQggQ/viewform",
    "EMAIL_FROM": "hello@vietnam-living-summit.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@vietnam-living-summit.com"]
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
